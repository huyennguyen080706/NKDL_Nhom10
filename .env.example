# Sao chép thành .env (không commit) hoặc đặt biến môi trường tương ứng.

# duckdb (mặc định, local) | bigquery
WAREHOUSE_BACKEND=duckdb

# Thư mục chứa các run raw (mỗi run có manifest.json). Bỏ trống để tự dò:
#   data/raw/runs  ->  ../Vnstock_RawData_Ingestion/raw/runs
RAW_RUNS_DIR=

# Đường dẫn kho DuckDB local
DUCKDB_PATH=warehouse/vnstock.duckdb

# --- Chỉ cần khi WAREHOUSE_BACKEND=bigquery ---
# Xác thực bằng: gcloud auth application-default login  (không lưu khóa JSON trong repo)
GCP_PROJECT_ID=
BQ_LOCATION=asia-southeast1
DBT_TARGET=local

# --- Chỉ cần khi thu thập dữ liệu mới bằng ingestion/ingest_vnstock.py ---
VNSTOCK_API_KEY=
