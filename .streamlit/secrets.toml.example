# Mẫu secrets cho Streamlit Community Cloud (App settings -> Secrets) hoặc .streamlit/secrets.toml local.
# KHÔNG commit file secrets.toml thật.
WAREHOUSE_BACKEND = "bigquery"
GCP_PROJECT_ID = "vnstock-medallion-nhom10"
BQ_LOCATION = "asia-southeast1"

# Nội dung key JSON của Service Account chỉ đọc (roles/bigquery.dataViewer + roles/bigquery.jobUser)
[gcp_service_account]
type = "service_account"
project_id = "vnstock-medallion-nhom10"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "streamlit-dashboard-reader@vnstock-medallion-nhom10.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."
universe_domain = "googleapis.com"
